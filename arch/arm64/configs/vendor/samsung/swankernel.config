# Compression
CONFIG_BUILD_ARM64_KERNEL_COMPRESSION_GZIP=y

# 32-bit VDSO
CONFIG_COMPAT_VDSO=y

# Clang specific configs
CONFIG_LTO=y
CONFIG_LTO_CLANG=y
CONFIG_THINLTO=y
CONFIG_CFI=y
CONFIG_CFI_CLANG=y
CONFIG_CFI_CLANG_SHADOW=y
CONFIG_SHADOW_CALL_STACK=y
CONFIG_SHADOW_CALL_STACK=y
CONFIG_SHADOW_CALL_STACK_VMAP=y
